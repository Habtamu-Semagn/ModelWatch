# Postgres (matches docker-compose.yml). Host port 55432 unless POSTGRES_HOST_PORT is set.
DATABASE_URL=postgres://evalkit:evalkit@localhost:55432/evalkit

# Free-tier provider keys (no credit card)
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Sandbox
SANDBOX_IMAGE=evalkit-sandbox:py311
SANDBOX_TIMEOUT_MS=30000
